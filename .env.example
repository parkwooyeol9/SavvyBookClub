# Shared secret for /api/cron/sync-books
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Canonical site URL (sitemap, Open Graph). Example: https://savvybookclub.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional affiliate / partner IDs (links work without them; params are appended when set)
NEXT_PUBLIC_ALADIN_PARTNER_ID=
NEXT_PUBLIC_YES24_AFFILIATE_CODE=

# Optional audience capture — newsletter form or Kakao channel URL
NEXT_PUBLIC_NEWSLETTER_URL=
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
